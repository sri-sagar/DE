{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF1Udemy"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sagarudemycourseadls1.dfs.core.windows.net"
		},
		"Databricks_ls_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0529-102204-m3seyy29"
		},
		"f1_process_data_Trigger_properties_pipeline_parameters_race_end_date": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"f1_process_data_trigger_2_properties_pipeline_parameters_race_end_date": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF1Udemy_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"Databricks_ls_properties_typeProperties_existingClusterId": {
						"value": "[parameters('Databricks_ls_properties_typeProperties_existingClusterId')]"
					},
					"f1_process_data_Trigger_properties_pipeline_parameters_race_end_date": {
						"value": "[parameters('f1_process_data_Trigger_properties_pipeline_parameters_race_end_date')]"
					},
					"f1_process_data_trigger_2_properties_pipeline_parameters_race_end_date": {
						"value": "[parameters('f1_process_data_trigger_2_properties_pipeline_parameters_race_end_date')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}